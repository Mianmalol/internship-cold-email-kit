# Gmail SMTP config. Auth uses a Google APP PASSWORD (not your normal password):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:     https://myaccount.google.com/apppasswords
#   3. mailmerge prompts for it at send time (it is NOT stored here).
[smtp_server]
host = smtp.gmail.com
port = 587
security = STARTTLS
username = you@gmail.com
